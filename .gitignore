# Gradle
.gradle/
build/
*.class

# The pinned external tools. Anchored with a leading slash on purpose: a bare
# "sockseek" matches ANY path component, and it silently swallowed the whole
# dev/litetook/sockseek package once already.
/sockseek.exe
/sockseek
/yt-dlp.exe
/yt-dlp
/yt-dlp_macos

# the Soulseek login and any local override of sockseek.conf
/sockseek.local.conf

# downloads, run logs, generated list files
/output/
/logs/
/work/

# your own playlists stay yours
/Playlists/*
!/Playlists/example.txt
